{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.tinycad.net/schemas/tinycad-plugins.schema.json",
  "title": "TinyCAD repository/release plugin catalog",
  "type": "object",
  "required": ["catalogVersion", "plugins"],
  "properties": {
    "catalogVersion": { "const": 1 },
    "plugins": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "version", "apiVersion", "platforms", "readme", "changelog", "documentation", "package"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "version": { "type": "string" }, "apiVersion": { "type": "string" },
          "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["browser", "electron"] } },
          "readme": { "type": "string", "pattern": "\\.[mM][dD]$" }, "changelog": { "type": "string", "pattern": "\\.[mM][dD]$" }, "documentation": { "type": "string", "pattern": "\\.[mM][dD]$" },
          "package": {
            "oneOf": [
              { "type": "object", "required": ["type", "asset"], "properties": { "type": { "const": "releaseAsset" }, "asset": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
              { "type": "object", "required": ["type", "manifest"], "properties": { "type": { "const": "source" }, "manifest": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    }
  }
}

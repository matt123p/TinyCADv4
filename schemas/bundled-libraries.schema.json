{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyCAD bundled libraries",
  "type": "object",
  "required": ["version", "libraries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "description": "Unique stable identifier used to remember user selections."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "\\.[tT][cC][lL][iI][bB]$",
            "description": "Relative file path inside bundled-libraries, using forward slashes. Absolute paths, traversal, and URLs are rejected."
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

istor headphone amplifier</NOTE_TEXT><NOTE_TEXT a="19,180" b="285,207" font="3" color="221B16" style="2" fill="0" direction="3" border_style="2">U1 and U2 use the same mono schematic. U3 supplies both channels. V1/V2 are line-input test sources and the 32-ohm resistors model separate headphone loads.The Stereo transient tab plots both outputs. The signal path is inverting.</NOTE_TEXT><WIRE a="137,111" b="158,111"/></TinyCAD><SimulationSheet id="af9c38f1-1b50-4c8f-832a-02920e75b1a3" name="Stereo transient" version="1">{"version":1,"instructions":"Run the 20 ms transient analysis to compare the left 1 kHz and right 1.6 kHz outputs across separate 32 ohm loads. Each input is 100 mV peak.","analysis":{"kind":"tran","duration":"20m","maxStep":"2u","startFrequency":"10Hz","stopFrequency":"100kHz","pointsPerDecade":100,"source":"","sweepStart":"0","sweepStop":"5","sweepStep":"0.1","input":"","output":"","reference":"0","temperature":"27","initialConditions":false},"signals":["left_out","right_out"],"parameters":{},"models":{},"runs":[],"retainResults":true,"traces":[]}</SimulationSheet><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>
<?xml version="1.0" encoding="utf-8"?><TinyCADSheets><DSNIDENTITY id="b917a6c1-a12a-4b6d-9193-2fe9aa4427f8"/><SPICE_MODEL_PACKS version="1">[{"id":"basic","version":"ebd2fe129c05","revision":"ebd2fe129c05f4af630a9a44093ebb2cabed663cb1fceb773d9b445bd1ee18c1","filename":"basic_ebd2fe129c05.lib","format":"templates","sha256":"25fd0c9d7ed426104ffd5cd5b348491c44cbeee6c401f3e690068debc82246ef","license":"GPL-3.0-only","licenseText":"TinyCAD Basic SPICE templates are licensed under GNU GPL version 3.\nhttps://www.gnu.org/licenses/gpl-3.0.html","spice":"{\"BASIC_RESISTOR\":{\"instance\":\"R$(refnum) %(1) %(2) $(Value) ?(not_empty(TC1), $(TC1), ) ?(not_empty(TC2),  $(TC2), )\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"TC1\":\"\",\"TC2\":\"\",\"Value\":\"1k\"}},\"BASIC_CAPACITOR\":{\"instance\":\"C$(refnum) %(1) %(2) $(Value) IC=$(Initial Voltage)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Initial Voltage\":\"0V\",\"Value\":\"100n\"}},\"BASIC_INDUCTOR\":{\"instance\":\"L$(refnum) %(1) %(2) $(Value)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Value\":\"1m\"}},\"BASIC_POTENTIOMETER\":{\"instance\":\"R$(refnum)A %(1) %(3) {max(1u,$(Value)*$(Wiper))}\\nR$(refnum)B %(3) %(2) {max(1u,$(Value)*(1-$(Wiper)))}\",\"prologue\":\"\",\"templatePins\":[\"1\",\"3\",\"2\"],\"attributes\":{\"Value\":\"10k\",\"Wiper\":\"0.5\"}},\"BASIC_NPN\":{\"instance\":\"Q$(refnum) %(3) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_NPN NPN(Is=1e-14 Bf=200 Vaf=100 Cje=10p Cjc=5p Tf=500p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"3\",\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_NPN\",\"Model File\":\"\"}},\"BASIC_PNP\":{\"instance\":\"Q$(refnum) %(3) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_PNP PNP(Is=1e-14 Bf=100 Vaf=100 Cje=10p Cjc=5p Tf=500p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"3\",\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_PNP\",\"Model File\":\"\"}},\"BASIC_NMOS\":{\"instance\":\"M$(refnum) %(D) %(G) %(S) %(S) $(Model Name) L=$(Length) W=$(Width)\",\"prologue\":\"?(empty(Model File),.model TC_NMOS NMOS(Level=1 Vto=1.5 Kp=20u Lambda=0.02 Gamma=0.5 Phi=0.7),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"D\",\"G\",\"S\"],\"attributes\":{\"Length\":\"10u\",\"Model File\":\"\",\"Model Name\":\"TC_NMOS\",\"Width\":\"100u\"}},\"BASIC_PMOS\":{\"instance\":\"M$(refnum) %(D) %(G) %(S) %(S) $(Model Name) L=$(Length) W=$(Width)\",\"prologue\":\"?(empty(Model File),.model TC_PMOS PMOS(Level=1 Vto=-1.5 Kp=10u Lambda=0.02 Gamma=0.5 Phi=0.7),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"D\",\"G\",\"S\"],\"attributes\":{\"Length\":\"10u\",\"Model File\":\"\",\"Model Name\":\"TC_PMOS\",\"Width\":\"100u\"}},\"BASIC_DIODE\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_D D(Is=1n N=1.8 Rs=0.5 Cjo=2p Tt=4n Bv=100 Ibv=10u),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_D\",\"Model File\":\"\"}},\"BASIC_ZENER\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_ZENER5V1 D(Is=1n N=1.6 Rs=2 Bv=5.1 Ibv=1m Cjo=80p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_ZENER5V1\",\"Model File\":\"\"}},\"BASIC_LED_RED\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_RED D(Is=1e-18 N=2 Rs=8 Eg=1.8 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_RED\",\"Model File\":\"\"}},\"BASIC_LED_GREEN\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_GREEN D(Is=1e-21 N=2 Rs=10 Eg=2.2 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_GREEN\",\"Model File\":\"\"}},\"BASIC_LED_BLUE\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_BLUE D(Is=1e-26 N=2 Rs=12 Eg=2.8 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_BLUE\",\"Model File\":\"\"}},\"BASIC_LED_YELLOW\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_YELLOW D(Is=1e-20 N=2 Rs=10 Eg=2 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_YELLOW\",\"Model File\":\"\"}},\"BASIC_UA741\":{\"instance\":\"X$(ref) %(3) %(2) %(7) %(4) %(6) $(Model)\",\"prologue\":\".subckt TC_UA741 P N VP VN OUT\\nRin P N 2Meg\\nBdrive 0 pole I=max(-15.9154943m,min(15.9154943m,0.2*(v(P)-v(N))))\\nRpole pole 0 1Meg\\nCpole pole 0 31.8309886n\\nBlimit drive 0 V=max(v(VN)+2,min(v(VP)-2,v(pole)))\\nRout drive OUT 75\\n.ends TC_UA741\",\"templatePins\":[\"3\",\"2\",\"7\",\"4\",\"6\"],\"attributes\":{\"Model\":\"TC_UA741\"}},\"BASIC_TRANSFORMER\":{\"instance\":\"LT$(refnum)P %(1) %(2) $(Primary inductance)\\nLT$(refnum)S %(3) %(4) $(Secondary inductance)\\nKT$(refnum) LT$(refnum)P LT$(refnum)S $(Coupling)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\",\"3\",\"4\"],\"attributes\":{\"Coupling\":\"0.999\",\"Primary inductance\":\"10m\",\"Secondary inductance\":\"10m\"}},\"BASIC_XTAL\":{\"instance\":\"X$(ref) %(1) %(2) TC_XTAL PARAMS: FREQ=$(Frequency) RM=$(Motional resistance) CM=$(Motional capacitance) C0=$(Shunt capacitance)\",\"prologue\":\".subckt TC_XTAL A B params: FREQ=8Meg RM=20 CM=20f C0=3p\\nRmot A mot1 {RM}\\nLmot mot1 mot2 {1/(39.47841760435743*FREQ*FREQ*CM)}\\nCmot mot2 B {CM}\\nCshunt A B {C0}\\n.ends TC_XTAL\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Frequency\":\"8Meg\",\"Motional capacitance\":\"20f\",\"Motional resistance\":\"20\",\"Shunt capacitance\":\"3p\"}},\"BASIC_CERAMIC\":{\"instance\":\"X$(ref) %(1) %(2) TC_CERAMIC PARAMS: FREQ=$(Frequency) RM=$(Motional resistance) CM=$(Motional capacitance) C0=$(Shunt capacitance)\",\"prologue\":\".subckt TC_CERAMIC A B params: FREQ=4Meg RM=10 CM=10p C0=30p\\nRmot A mot1 {RM}\\nLmot mot1 mot2 {1/(39.47841760435743*FREQ*FREQ*CM)}\\nCmot mot2 B {CM}\\nCshunt A B {C0}\\n.ends TC_CERAMIC\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Frequency\":\"4Meg\",\"Motional capacitance\":\"10p\",\"Motional resistance\":\"10\",\"Shunt capacitance\":\"30p\"}},\"BASIC_VOLTAGE\":{\"instance\":\"V$(refnum) %(1) %(2) DC $(Value)?(not_empty(AC magnitude), AC $(AC magnitude) $(AC Phase),)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"AC Phase\":\"0\",\"AC magnitude\":\"\",\"Value\":\"5\"}},\"BASIC_CURRENT\":{\"instance\":\"I$(refnum) %(1) %(2) DC $(Value)?(not_empty(AC magnitude), AC $(AC magnitude) $(AC Phase),)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"AC Phase\":\"0\",\"AC magnitude\":\"\",\"Value\":\"1m\"}}}"}]</SPICE_MODEL_PACKS><TinyCAD id="5b6bc779-9987-46c3-80e2-5784ca783b0c"><NAME>Stereo headphone amplifier</NAME><DETAILS><Size width="1455" height="1020"/><GUIDES horiz="7" vert="5"/><TITLE>Stereo headphone amplifier</TITLE><AUTHOR>TinyCAD example</AUTHOR><REVISION>1.0</REVISION><DOCNUMBER></DOCNUMBER><ORGANISATION></ORGANISATION><SHEETS>1 of 1</SHEETS><SHOWS>1</SHOWS><DATE></DATE><GRID spacing="50" snap="1"/></DETAILS><FONT id="1"><HEIGHT>-10</HEIGHT><FACENAME>Arial</FACENAME><WIDTH>0</WIDTH><WEIGHT>400</WEIGHT><ITALIC>0</ITALIC><UNDERLINE>0</UNDERLINE><STRIKEOUT>0</STRIKEOUT><CHARSET>0</CHARSET></FONT><FONT id="3"><HEIGHT>10</HEIGHT><FACENAME>Arial</FACENAME><WIDTH>0</WIDTH><WEIGHT>400</WEIGHT><ITALIC>0</ITALIC><UNDERLINE>0</UNDERLINE><STRIKEOUT>0</STRIKEOUT><CHARSET>0</CHARSET></FONT><STYLE id="1"><STYLE>0</STYLE><COLOR>D47800</COLOR><THICKNESS>1</THICKNESS></STYLE><STYLE id="2"><STYLE>5</STYLE><COLOR>000000</COLOR><THICKNESS>1</THICKNESS></STYLE><STYLE id="3"><STYLE>0</STYLE><COLOR>000000</COLOR><THICKNESS>1</THICKNESS></STYLE><SYMBOLDEF id="25"><NAME type="0">Resistor (US)</NAME><GUID>stereo-spice-essentials-24</GUID><REF type="0"
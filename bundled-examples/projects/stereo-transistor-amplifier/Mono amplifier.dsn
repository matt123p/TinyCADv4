 b="220,99"/><WIRE a="220,81" b="220,86"/><WIRE a="220,86" b="220,91"/><JUNCTION pos="220,86"/><WIRE a="220,86" b="237,86"/><WIRE a="245,86" b="266,86"/><LABEL pos="253.390625,86" font="3" color="221B16" direction="3" style="0">OUT</LABEL><NOTE_TEXT a="17,10" b="282,22" font="3" color="221B16" style="3" fill="0" direction="3" border_style="2"># Mono headphone amplifier</NOTE_TEXT><NOTE_TEXT a="18,166" b="280,194" font="3" color="221B16" style="3" fill="0" direction="3" border_style="2">Q1 provides inverting Class A voltage gain. D1 and D2 bias the complementary Class AB output pair, and R8/R9 provide emitter degeneration. R4 sets the AC gain with C2 bypassing R5.C3 is non-polar. C4 blocks the output DC bias. Use 16 V or higher capacitors where applicable.</NOTE_TEXT></TinyCAD><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>
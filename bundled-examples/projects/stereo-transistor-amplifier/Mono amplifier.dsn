<?xml version="1.0" encoding="utf-8"?><TinyCADSheets><DSNIDENTITY id="0aaf83a7-0463-44bf-b4aa-188c6bd5ac40"/><SPICE_MODEL_PACKS version="1">[{"id":"openjellybean","version":"0.6.0","revision":"0d0d9b659b202368dc419f8276bacb1e39694915","filename":"openjellybean_0_6_0.lib","sha256":"bc0304fe2fae01979bcbd6eb74466a3b25e8a632088ffa7ce19b385ada799163","license":"MIT","licenseText":"MIT License\n\nCopyright (c) 2026 openjellybean contributors\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n","spice":"* =============================================================================\n* openjellybean - generic \"jelly bean\" SPICE models\n* Version 0.6.0\n* https://github.com/xdylanm/openjellybean\n* SPDX-License-Identifier: MIT\n* Copyright (c) 2026 openjellybean contributors. See LICENSE for the full text.\n*\n* Original models written from scratch: parameters were fitted in ngspice to\n* typical values published in public datasheets. No manufacturer model file\n* was copied or adapted. They BEHAVE LIKE the named parts at typical bias;\n* they are not the manufacturer's models and carry no manufacturer warranty.\n* Names end in _OJ so they never collide with vendor models in the same tree.\n*\n* Tested with ngspice 47. Uses only standard SPICE syntax plus the VDMOS\n* model (ngspice &gt;= 47, LTspice) and subcircuit params: (ngspice, LTspice).\n* =============================================================================\n\n* ---------------------------------------------------------------- BJTs ------\n* BC547B_OJ : small-signal NPN, 45 V / 100 mA class, hFE group B\n* BC557B_OJ : complementary PNP\n.model BC547B_OJ NPN(IS=1.8e-14 NF=1 BF=330 VAF=65 IKF=0.12 ISE=5e-14 NE=1.5\n+ BR=4 NR=1 VAR=20 IKR=0.1 ISC=1e-13 NC=2\n+ RB=40 RE=0.4 RC=1.2\n+ CJE=10p VJE=0.7 MJE=0.33 CJC=4p VJC=0.6 MJC=0.33 FC=0.5\n+ TF=0.45n XTF=2 VTF=10 ITF=0.1 TR=50n\n+ EG=1.11 XTI=3 XTB=1.5)\n\n.model BC557B_OJ PNP(IS=1.8e-14 NF=1 BF=330 VAF=40 IKF=0.1 ISE=5e-14 NE=1.5\n+ BR=6 NR=1 VAR=15 IKR=0.08 ISC=1e-13 NC=2\n+ RB=40 RE=0.6 RC=1.2\n+ CJE=12p VJE=0.7 MJE=0.33 CJC=7p VJC=0.6 MJC=0.33 FC=0.5\n+ TF=0.95n XTF=2 VTF=10 ITF=0.1 TR=60n\n+ EG=1.11 XTI=3 XTB=1.5)\n\n* 2N3904_OJ : 40 V / 200 mA general-purpose NPN (TO-92 pinout E-B-C)\n* 2N3906_OJ : complementary PNP\n.model 2N3904_OJ NPN(IS=1e-14 NF=1 BF=200 VAF=90 IKF=0.07 ISE=4e-14 NE=1.5\n+ BR=4 NR=1 VAR=20 IKR=0.1 ISC=1e-13 NC=2\n+ RB=10 RE=0.3 RC=1\n+ CJE=6p VJE=0.7 MJE=0.33 CJC=5p VJC=0.6 MJC=0.33 FC=0.5\n+ TF=0.4n XTF=2 VTF=10 ITF=0.1 TR=30n\n+ EG=1.11 XTI=3 XTB=1.5)\n\n.model 2N3906_OJ PNP(IS=1e-14 NF=1 BF=200 VAF=35 IKF=0.08 ISE=4e-14 NE=1.5\n+ BR=4 NR=1 VAR=15 IKR=0.08 ISC=1e-13 NC=2\n+ RB=10 RE=0.4 RC=1.5\n+ CJE=8p VJE=0.7 MJE=0.33 CJC=6.5p VJC=0.6 MJC=0.33 FC=0.5\n+ TF=0.5n XTF=2 VTF=10 ITF=0.1 TR=40n\n+ EG=1.11 XTI=3 XTB=1.5)\n\n* ------------------------------------------------------------ MOSFETs -------\n* VDMOS model: 3 terminals (D G S), body diode built in.\n* 2N7000_OJ : 60 V small-signal N-channel (also a fair 2N7002 / BS170 stand-in)\n* BS250_OJ  : 45 V small-signal P-channel\n.model 2N7000_OJ VDMOS(VTO=2.0 KP=0.3 LAMBDA=0.01 RD=0.6 RS=0.1 RG=10\n+ CGS=16p CGDMAX=20p CGDMIN=3p A=0.5\n+ CJO=40p VJ=0.75 M=0.5 IS=1e-13 N=1.1 RB=0.2 BV=60 IBV=10u TT=20n)\n\n.model BS250_OJ VDMOS(pchan VTO=-2.1 KP=0.02 LAMBDA=0.01 RD=1.8 RS=0.2 RG=10\n+ CGS=25p CGDMAX=21p CGDMIN=3.7p A=0.5\n+ CJO=57p VJ=0.75 M=0.5 IS=1e-13 N=1.1 RB=0.5 BV=45 IBV=10u TT=30n)\n\n* -------------------------------------------------------------- JFETs -------\n* Pins D G S. VTO is negative for both polarities, as SPICE defines it.\n* 2N5457_OJ .. 2N5459_OJ : N-channel general-purpose amplifiers, 25 V\n.model 2N5457_OJ NJF(VTO=-3.06 BETA=3.2e-4 LAMBDA=3.3e-3 RD=20 RS=20\n+ CGS=3.2p CGD=5.5p PB=1 IS=1e-14 FC=0.5)\n.model 2N5458_OJ NJF(VTO=-4.28 BETA=3.4e-4 LAMBDA=1.7e-3 RD=20 RS=20\n+ CGS=3.2p CGD=5.4p PB=1 IS=1e-14 FC=0.5)\n.model 2N5459_OJ NJF(VTO=-5.7 BETA=2.9e-4 LAMBDA=1.1e-3 RD=20 RS=20\n+ CGS=3.2p CGD=5.2p PB=1 IS=1e-14 FC=0.5)\n\n* J112_OJ, J113_OJ : N-channel analog switches, 35 V\n.model J112_OJ NJF(VTO=-2.2 BETA=6.6e-3 LAMBDA=0.035 RD=7 RS=7\n+ CGS=13p CGD=9p PB=1.25 IS=1e-15 FC=0.5)\n.model J113_OJ NJF(VTO=-1.5 BETA=8.3e-3 LAMBDA=0.035 RD=12 RS=12\n+ CGS=13p CGD=9p PB=1.25 IS=1e-15 FC=0.5)\n\n* PN4392_OJ, PN4393_OJ : N-channel switches, 40 V\n.model PN4392_OJ NJF(VTO=-2.8 BETA=4.4e-3 LAMBDA=0.035 RD=4 RS=4\n+ CGS=12p CGD=9p PB=1.17 IS=1e-15 FC=0.5)\n.model PN4393_OJ NJF(VTO=-1.2 BETA=7.4e-3 LAMBDA=0.035 RD=10 RS=10\n+ CGS=12.5p CGD=8p PB=1.17 IS=1e-15 FC=0.5)\n\n* 2N5460_OJ .. 2N5462_OJ : P-channel general-purpose amplifiers, 40 V\n.model 2N5460_OJ PJF(VTO=-2.2 BETA=5.3e-4 LAMBDA=5e-3 RD=40 RS=40\n+ CGS=4.8p CGD=2.3p PB=1 IS=1e-14 FC=0.5)\n.model 2N5461_OJ PJF(VTO=-3 BETA=5.1e-4 LAMBDA=5e-3 RD=30 RS=30\n+ CGS=4.8p CGD=2.3p PB=1 IS=1e-14 FC=0.5)\n.model 2N5462_OJ PJF(VTO=-5 BETA=3.7e-4 LAMBDA=3e-3 RD=20 RS=20\n+ CGS=4.7p CGD=2.7p PB=1 IS=1e-14 FC=0.5)\n\n* ------------------------------------------------------------- Diodes -------\n* 1N4148_OJ : small-signal fast switching (also 1N914)\n.model 1N4148_OJ D(IS=2.9n N=1.85 RS=0.9 BV=100 IBV=100u\n+ CJO=2p VJ=0.5 M=0.33 TT=2.5n EG=1.11 XTI=3)\n\n* 1N5819_OJ : 1 A / 40 V Schottky\n.model 1N5819_OJ D(IS=1.6u N=1.05 RS=0.057 BV=40 IBV=1m\n+ CJO=300p VJ=0.5 M=0.45 TT=0 EG=0.69 XTI=2)\n\n* BAT54_OJ : 200 mA / 30 V small-signal Schottky (one diode of the A/C/S duals)\n.model BAT54_OJ D(IS=14n N=1 RS=1.1 BV=30 IBV=10u\n+ CJO=13.5p VJ=0.3 M=0.39 TT=0 EG=0.69 XTI=2)\n\n* B140_OJ : 1 A / 40 V Schottky rectifier (also a fair SB140 stand-in)\n.model B140_OJ D(IS=200n N=1 RS=0.062 BV=45 IBV=500u\n+ CJO=310p VJ=0.5 M=0.45 TT=0 EG=0.69 XTI=2)\n\n* ------------------------------------------------------------- Zeners -------\n* Generic zener:  X1 anode cathode ZENER_OJ params: VZ=5.1 IZT=5m RZ=40 NK=1.5\n*   VZ  : zener voltage at test current IZT\n*   RZ  : total dynamic impedance at IZT (as quoted on datasheets)\n*   NK  : knee softness (1 = sharp, 2-3 = the soft knee of sub-5 V parts)\n.subckt ZENER_OJ a k params: VZ=5.1 IZT=5m RZ=40 NK=1.5\n.param RSER={max(RZ - NK*0.025865/IZT, 0.01)}\n.param VOFS={VZ - IZT*RSER - NK*0.025865*ln(IZT/1e-12)}\nDf  a k dfwd\nVof k n1 {VOFS}\nDbk n1 n2 dknee\nRz  n2 a {RSER}\n.model dfwd  D(IS=3n N=1.8 RS=0.5 CJO=40p VJ=0.75 M=0.4 TT=50n)\n.model dknee D(IS=1e-12 N={NK})\n.ends ZENER_OJ\n\n* 500 mW glass zeners, BZX79 class, specified at IZT = 5 mA\n.subckt BZX79C3V3_OJ a k\nX1 a k ZENER_OJ params: VZ=3.3 IZT=5m RZ=85 NK=3\n.ends\n.subckt BZX79C4V7_OJ a k\nX1 a k ZENER_OJ params: VZ=4.7 IZT=5m RZ=50 NK=2.5\n.ends\n.subckt BZX79C5V1_OJ a k\nX1 a k ZENER_OJ params: VZ=5.1 IZT=5m RZ=40 NK=2\n.ends\n.subckt BZX79C5V6_OJ a k\nX1 a k ZENER_OJ params: VZ=5.6 IZT=5m RZ=15 NK=1.5\n.ends\n.subckt BZX79C6V2_OJ a k\nX1 a k ZENER_OJ params: VZ=6.2 IZT=5m RZ=6 NK=1\n.ends\n.subckt BZX79C9V1_OJ a k\nX1 a k ZENER_OJ params: VZ=9.1 IZT=5m RZ=6 NK=1\n.ends\n.subckt BZX79C12_OJ a k\nX1 a k ZENER_OJ params: VZ=12 IZT=5m RZ=10 NK=1\n.ends\n.subckt BZX79C15_OJ a k\nX1 a k ZENER_OJ params: VZ=15 IZT=5m RZ=10 NK=1\n.ends\n* 1 W, 1N47xxA class, specified at the datasheet IZT\n.subckt 1N4733A_OJ a k\nX1 a k ZENER_OJ params: VZ=5.1 IZT=49m RZ=7 NK=2\n.ends\n.subckt 1N4742A_OJ a k\nX1 a k ZENER_OJ params: VZ=12 IZT=21m RZ=9 NK=1\n.ends\n\n* ---------------------------------------------------------------- LEDs ------\n* Generic 5 mm indicator LEDs, one color each:  D1 a k LED_RED_OJ\n* LED_RED_OJ   : high-efficiency red, VF about 1.9 V at 10 mA\n* LED_GREEN_OJ : standard green, VF about 2.0 V at 10 mA\n* LED_BLUE_OJ  : InGaN blue, VF about 3.3 V at 20 mA\n.model LED_RED_OJ D(IS=1.4n N=4.64 RS=1.7 BV=10 IBV=10u\n+ CJO=15p VJ=0.75 M=0.33 TT=0 EG=2.46 XTI=0)\n.model LED_GREEN_OJ D(IS=1.1e-18 N=2 RS=10 BV=10 IBV=10u\n+ CJO=15p VJ=0.75 M=0.33 TT=0 EG=2.44 XTI=0)\n.model LED_BLUE_OJ D(IS=1.4e-10 N=6 RS=19.7 BV=10 IBV=10u\n+ CJO=65p VJ=0.75 M=0.33 TT=0 EG=3.8 XTI=0)\n\n* ------------------------------------------------------------- Op-amps ------\n* Pin order (TI / LTspice convention):  +IN  -IN  V+  V-  OUT\n* Generic single-pole + second-pole macromodel with slew limit, output swing\n* limits, short-circuit current limit and supply current that follows the\n* load (output current is drawn from the correct rail).\n* Not modelled: input common-mode range limits / phase reversal, noise,\n* CMRR/PSRR, offset drift, LM358 crossover distortion.\n*   GBW [Hz]  SR [V/s]  AOL [V/V]  VOS [V]  IB [A, into each pin]\n*   ISC [A]   IQ [A per amplifier]  VOH/VOL: headroom from V+ / V- [V]\n*   ROUT: open-loop output resistance [ohm]  FP2: second pole [Hz]\n.subckt OPAMP_OJ inp inn vcc vee out params: GBW=3e6 SR=13e6 AOL=200k\n+ VOS=0 IB=30p RIN=1e12 CIN=3p ISC=30m IQ=1.4m VOH=1.5 VOL=1.5 ROUT=100 FP2=4.5e6\n.param CC=1n\n.param IMAX={SR*CC}\n.param GM={6.2831853*GBW*CC}\n.param VLIN={IMAX/GM}\nBmid mid 0 V={(V(vcc)+V(vee))/2}\nIq   vcc vee {IQ}\nVos  inp inp1 {VOS}\nIbp  inp mid {IB}\nIbn  inn mid {IB}\nRin  inp1 inn {RIN}\nCinp inp1 mid {CIN}\nCinn inn mid {CIN}\n* transconductance with tanh slew limit -&gt; integrator\nBg   mid int I={IMAX}*tanh((V(inp1)-V(inn))/{VLIN})\nCc   int mid {CC}\nRint int mid {AOL/GM}\n* output-swing clamps\nBhi  nhi 0 V=V(vcc)-{VOH}\nBlo  nlo 0 V=V(vee)+{VOL}\nDhi  int nhi dclamp\nDlo  nlo int dclamp\n* second pole\nE2   p2a 0 int 0 1\nRp2  p2a p2 1k\nCp2  p2 0 {1/(6.2831853*FP2*1k)}\n* current-limited output, current drawn from the rails\n* soft current limit: I = ISC*x/(1+x^4)^0.25, x=(V(p2)-V(out))/(ROUT*ISC)\nBx   x 0 V=(V(p2)-V(out))/({ROUT}*{ISC})\nBsrc vcc out I={ISC}*0.5*(abs(V(x))+V(x))/pwr(1+V(x)*V(x)*V(x)*V(x),0.25)\nBsnk out vee I={ISC}*0.5*(abs(V(x))-V(x))/pwr(1+V(x)*V(x)*V(x)*V(x),0.25)\n.model dclamp D(IS=1e-15 N=0.02)\n.ends OPAMP_OJ\n\n* TL07X_OJ : one section of a TL071/TL072/TL074-class JFET-input op-amp\n.subckt TL07X_OJ inp inn vcc vee out\n* GBW/FP2 chosen so the unity-gain frequency lands at ~3 MHz with ~55-60 deg PM\nX1 inp inn vcc vee out OPAMP_OJ params: GBW=3.5e6 SR=13e6 AOL=200k IB=30p\n+ RIN=1e12 CIN=3p ISC=30m IQ=1.4m VOH=1.5 VOL=1.5 ROUT=100 FP2=4.5e6\n.ends TL07X_OJ\n\n* TL072_OJ : complete dual package, pins 1-8 in order:\n*   1OUT 1IN- 1IN+ VCC- 2IN+ 2IN- 2OUT VCC+\n.subckt TL072_OJ out1 inn1 inp1 vee inp2 inn2 out2 vcc\nXA inp1 inn1 vcc vee out1 TL07X_OJ\nXB inp2 inn2 vcc vee out2 TL07X_OJ\n.ends TL072_OJ\n\n* TL074_OJ : complete quad package, pins 1-14 in order:\n*   1OUT 1IN- 1IN+ VCC+ 2IN+ 2IN- 2OUT 3OUT 3IN- 3IN+ VCC- 4IN+ 4IN- 4OUT\n.subckt TL074_OJ out1 inn1 inp1 vcc inp2 inn2 out2 out3 inn3 inp3 vee inp4 inn4 out4\nXA inp1 inn1 vcc vee out1 TL07X_OJ\nXB inp2 inn2 vcc vee out2 TL07X_OJ\nXC inp3 inn3 vcc vee out3 TL07X_OJ\nXD inp4 inn4 vcc vee out4 TL07X_OJ\n.ends TL074_OJ\n\n* LM358_OJ : one section of an LM358/LM324-class single-supply op-amp\n*   (output swings to within ~10 mV of V- at light load; bias current flows\n*    out of the pins, hence negative IB)\n.subckt LM358_OJ inp inn vcc vee out\nX1 inp inn vcc vee out OPAMP_OJ params: GBW=0.8e6 SR=0.3e6 AOL=100k IB=-20n\n+ RIN=10Meg CIN=3p ISC=30m IQ=0.35m VOH=1.5 VOL=0.02 ROUT=100 FP2=1.5e6\n.ends LM358_OJ\n\n* LM358_DUAL_OJ : complete dual package, pins 1-8 in order:\n*   1OUT 1IN- 1IN+ GND 2IN+ 2IN- 2OUT VCC+\n.subckt LM358_DUAL_OJ out1 inn1 inp1 vee inp2 inn2 out2 vcc\nXA inp1 inn1 vcc vee out1 LM358_OJ\nXB inp2 inn2 vcc vee out2 LM358_OJ\n.ends LM358_DUAL_OJ\n\n* LM324_QUAD_OJ : complete quad package, pins 1-14 in order:\n*   1OUT 1IN- 1IN+ VCC+ 2IN+ 2IN- 2OUT 3OUT 3IN- 3IN+ GND 4IN+ 4IN- 4OUT\n*   Sections follow the LM324's own datasheet: faster than LM358_OJ, half the supply current.\n.subckt LM324_QUAD_OJ out1 inn1 inp1 vcc inp2 inn2 out2 out3 inn3 inp3 vee inp4 inn4 out4\n.subckt section inp inn vcc vee out\nX1 inp inn vcc vee out OPAMP_OJ params: GBW=1.34e6 SR=0.5e6 AOL=100k IB=-20n\n+ RIN=10Meg CIN=3p ISC=30m IQ=0.175m VOH=1.5 VOL=0.02 ROUT=100 FP2=2.5e6\n.ends section\nXA inp1 inn1 vcc vee out1 section\nXB inp2 inn2 vcc vee out2 section\nXC inp3 inn3 vcc vee out3 section\nXD inp4 inn4 vcc vee out4 section\n.ends LM324_QUAD_OJ\n\n* ------------------------------------------------------- Potentiometers -----\n* Generic linear potentiometer:  X1 a w b POT_OJ params: R=10k POS=0.5\n*   R   : total resistance from A to B [ohm]\n*   POS : wiper position, 0 = at A, 1 = at B (limited to that range)\n.subckt POT_OJ a w b params: R=10k POS=0.5\n.param FRAC={max(min(POS,1),0)}\nRa a w {max(R*FRAC,1e-3)}\nRb w b {max(R*(1-FRAC),1e-3)}\n.ends POT_OJ\n"},{"id":"basic","version":"ebd2fe129c05","revision":"ebd2fe129c05f4af630a9a44093ebb2cabed663cb1fceb773d9b445bd1ee18c1","filename":"basic_ebd2fe129c05.lib","format":"templates","sha256":"25fd0c9d7ed426104ffd5cd5b348491c44cbeee6c401f3e690068debc82246ef","license":"GPL-3.0-only","licenseText":"TinyCAD Basic SPICE templates are licensed under GNU GPL version 3.\nhttps://www.gnu.org/licenses/gpl-3.0.html","spice":"{\"BASIC_RESISTOR\":{\"instance\":\"R$(refnum) %(1) %(2) $(Value) ?(not_empty(TC1), $(TC1), ) ?(not_empty(TC2),  $(TC2), )\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"TC1\":\"\",\"TC2\":\"\",\"Value\":\"1k\"}},\"BASIC_CAPACITOR\":{\"instance\":\"C$(refnum) %(1) %(2) $(Value) IC=$(Initial Voltage)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Initial Voltage\":\"0V\",\"Value\":\"100n\"}},\"BASIC_INDUCTOR\":{\"instance\":\"L$(refnum) %(1) %(2) $(Value)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Value\":\"1m\"}},\"BASIC_POTENTIOMETER\":{\"instance\":\"R$(refnum)A %(1) %(3) {max(1u,$(Value)*$(Wiper))}\\nR$(refnum)B %(3) %(2) {max(1u,$(Value)*(1-$(Wiper)))}\",\"prologue\":\"\",\"templatePins\":[\"1\",\"3\",\"2\"],\"attributes\":{\"Value\":\"10k\",\"Wiper\":\"0.5\"}},\"BASIC_NPN\":{\"instance\":\"Q$(refnum) %(3) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_NPN NPN(Is=1e-14 Bf=200 Vaf=100 Cje=10p Cjc=5p Tf=500p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"3\",\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_NPN\",\"Model File\":\"\"}},\"BASIC_PNP\":{\"instance\":\"Q$(refnum) %(3) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_PNP PNP(Is=1e-14 Bf=100 Vaf=100 Cje=10p Cjc=5p Tf=500p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"3\",\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_PNP\",\"Model File\":\"\"}},\"BASIC_NMOS\":{\"instance\":\"M$(refnum) %(D) %(G) %(S) %(S) $(Model Name) L=$(Length) W=$(Width)\",\"prologue\":\"?(empty(Model File),.model TC_NMOS NMOS(Level=1 Vto=1.5 Kp=20u Lambda=0.02 Gamma=0.5 Phi=0.7),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"D\",\"G\",\"S\"],\"attributes\":{\"Length\":\"10u\",\"Model File\":\"\",\"Model Name\":\"TC_NMOS\",\"Width\":\"100u\"}},\"BASIC_PMOS\":{\"instance\":\"M$(refnum) %(D) %(G) %(S) %(S) $(Model Name) L=$(Length) W=$(Width)\",\"prologue\":\"?(empty(Model File),.model TC_PMOS PMOS(Level=1 Vto=-1.5 Kp=10u Lambda=0.02 Gamma=0.5 Phi=0.7),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"D\",\"G\",\"S\"],\"attributes\":{\"Length\":\"10u\",\"Model File\":\"\",\"Model Name\":\"TC_PMOS\",\"Width\":\"100u\"}},\"BASIC_DIODE\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_D D(Is=1n N=1.8 Rs=0.5 Cjo=2p Tt=4n Bv=100 Ibv=10u),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_D\",\"Model File\":\"\"}},\"BASIC_ZENER\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_ZENER5V1 D(Is=1n N=1.6 Rs=2 Bv=5.1 Ibv=1m Cjo=80p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_ZENER5V1\",\"Model File\":\"\"}},\"BASIC_LED_RED\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_RED D(Is=1e-18 N=2 Rs=8 Eg=1.8 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_RED\",\"Model File\":\"\"}},\"BASIC_LED_GREEN\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_GREEN D(Is=1e-21 N=2 Rs=10 Eg=2.2 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_GREEN\",\"Model File\":\"\"}},\"BASIC_LED_BLUE\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_BLUE D(Is=1e-26 N=2 Rs=12 Eg=2.8 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_BLUE\",\"Model File\":\"\"}},\"BASIC_LED_YELLOW\":{\"instance\":\"D$(refnum) %(1) %(2) $(Model)\",\"prologue\":\"?(empty(Model File),.model TC_LED_YELLOW D(Is=1e-20 N=2 Rs=10 Eg=2 Cjo=10p),.include \\\"$(Model File)\\\")\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Model\":\"TC_LED_YELLOW\",\"Model File\":\"\"}},\"BASIC_UA741\":{\"instance\":\"X$(ref) %(3) %(2) %(7) %(4) %(6) $(Model)\",\"prologue\":\".subckt TC_UA741 P N VP VN OUT\\nRin P N 2Meg\\nBdrive 0 pole I=max(-15.9154943m,min(15.9154943m,0.2*(v(P)-v(N))))\\nRpole pole 0 1Meg\\nCpole pole 0 31.8309886n\\nBlimit drive 0 V=max(v(VN)+2,min(v(VP)-2,v(pole)))\\nRout drive OUT 75\\n.ends TC_UA741\",\"templatePins\":[\"3\",\"2\",\"7\",\"4\",\"6\"],\"attributes\":{\"Model\":\"TC_UA741\"}},\"BASIC_TRANSFORMER\":{\"instance\":\"LT$(refnum)P %(1) %(2) $(Primary inductance)\\nLT$(refnum)S %(3) %(4) $(Secondary inductance)\\nKT$(refnum) LT$(refnum)P LT$(refnum)S $(Coupling)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\",\"3\",\"4\"],\"attributes\":{\"Coupling\":\"0.999\",\"Primary inductance\":\"10m\",\"Secondary inductance\":\"10m\"}},\"BASIC_XTAL\":{\"instance\":\"X$(ref) %(1) %(2) TC_XTAL PARAMS: FREQ=$(Frequency) RM=$(Motional resistance) CM=$(Motional capacitance) C0=$(Shunt capacitance)\",\"prologue\":\".subckt TC_XTAL A B params: FREQ=8Meg RM=20 CM=20f C0=3p\\nRmot A mot1 {RM}\\nLmot mot1 mot2 {1/(39.47841760435743*FREQ*FREQ*CM)}\\nCmot mot2 B {CM}\\nCshunt A B {C0}\\n.ends TC_XTAL\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Frequency\":\"8Meg\",\"Motional capacitance\":\"20f\",\"Motional resistance\":\"20\",\"Shunt capacitance\":\"3p\"}},\"BASIC_CERAMIC\":{\"instance\":\"X$(ref) %(1) %(2) TC_CERAMIC PARAMS: FREQ=$(Frequency) RM=$(Motional resistance) CM=$(Motional capacitance) C0=$(Shunt capacitance)\",\"prologue\":\".subckt TC_CERAMIC A B params: FREQ=4Meg RM=10 CM=10p C0=30p\\nRmot A mot1 {RM}\\nLmot mot1 mot2 {1/(39.47841760435743*FREQ*FREQ*CM)}\\nCmot mot2 B {CM}\\nCshunt A B {C0}\\n.ends TC_CERAMIC\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"Frequency\":\"4Meg\",\"Motional capacitance\":\"10p\",\"Motional resistance\":\"10\",\"Shunt capacitance\":\"30p\"}},\"BASIC_VOLTAGE\":{\"instance\":\"V$(refnum) %(1) %(2) DC $(Value)?(not_empty(AC magnitude), AC $(AC magnitude) $(AC Phase),)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"AC Phase\":\"0\",\"AC magnitude\":\"\",\"Value\":\"5\"}},\"BASIC_CURRENT\":{\"instance\":\"I$(refnum) %(1) %(2) DC $(Value)?(not_empty(AC magnitude), AC $(AC magnitude) $(AC Phase),)\",\"prologue\":\"\",\"templatePins\":[\"1\",\"2\"],\"attributes\":{\"AC Phase\":\"0\",\"AC magnitude\":\"\",\"Value\":\"1m\"}}}"}]</SPICE_MODEL_PACKS><HierarchicalSymbol id="85ab801c-b790-4a1a-8ca7-246d02ddadbf"><NAME>Hierarchical Symbol</NAME><DETAILS><Size width="1455" height="1020"/><GUIDES horiz="7" vert="5"/><TITLE></TITLE><AUTHOR></AUTHOR><REVISION>1.0</REVISION><DOCNUMBER></DOCNUMBER><ORGANISATION></ORGANISATION><SHEETS>1 of 1</SHEETS><SHOWS>1</SHOWS><DATE></DATE><GRID spacing="50" snap="1"/></DETAILS><FONT id="1"><HEIGHT>-10</HEIGHT><FACENAME>Arial</FACENAME><WIDTH>0</WIDTH><WEIGHT>400</WEIGHT><ITALIC>0</ITALIC><UNDERLINE>0</UNDERLINE><STRIKEOUT>0</STRIKEOUT><CHARSET>0</CHARSET></FONT><FONT id="3"><HEIGHT>10</HEIGHT><FACENAME>Arial</FACENAME><WIDTH>0</WIDTH><WEIGHT>400</WEIGHT><ITALIC>0</ITALIC><UNDERLINE>0</UNDERLINE><STRIKEOUT>0</STRIKEOUT><CHARSET>0</CHARSET></FONT><STYLE id="1"><STYLE>0</STYLE><COLOR>221B16</COLOR><THICKNESS>1</THICKNESS></STYLE><STYLE id="2"><STYLE>5</STYLE><COLOR>000000</COLOR><THICKNESS>1</THICKNESS></STYLE><OPTIONS><GRID>1</GRID><UNITS>0</UNITS><SHOW_LABEL_CONNECTION_POINT>1</SHOW_LABEL_CONNECTION_POINT><COLOR_WIRE>FF0000</COLOR_WIRE><COLOR_BUS>0000FF</COLOR_BUS><COLOR_JUNCTION>000000</COLOR_JUNCTION><COLOR_NOCONNECT>000000</COLOR_NOCONNECT><COLOR_LABEL>208000</COLOR_LABEL><COLOR_POWER>000000</COLOR_POWER><COLOR_PIN>4040C0</COLOR_PIN><COLOR_HIDDEN_PIN>208020</COLOR_HIDDEN_PIN><COLOR_BACKGROUND>FFFFFF</COLOR_BACKGROUND><COLOR_NOTETEXT_FILL>AFFFFF</COLOR_NOTETEXT_FILL><COLOR_NOTETEXT_LINE>FF0000</COLOR_NOTETEXT_LINE><COLOR_NOTETEXT_TEXT>FF0000</COLOR_NOTETEXT_TEXT></OPTIONS><RECTANGLE a="25,20" b="61,50" style="1" fill="0"/><PIN pos="21,32" direction="3" number="1" length="20" number_pos="0" centre_name="0" which="0" elec="0" part="0" show="1">IN</PIN><PIN pos="65,32" direction="2" number="2" length="20" number_pos="0" centre_name="
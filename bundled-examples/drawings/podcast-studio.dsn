type="1">Dynamic vocal microphone</NAME><GUID>audio-music/1</GUID><REF type="1">A?</REF><DESCRIPTION>Dynamic vocal microphone. Mic-level XLR cable endpoint; phantom-power needs depend on the actual microphone.. Compact system-layout symbols for live sound, studios, recording, podcasts, worship and schools. Each labelled socket is one whole-cable endpoint, not individual electrical contacts. RF marks are explicit logical wireless links. Generic equipment layouts describe the listed sockets, not any specific brand/model. No SPICE or acoustic/firmware simulation.</DESCRIPTION><PPP>1</PPP><REF_POINT pos="18,42" power="false" part="1"/><TinyCAD><RECTANGLE a="7,10" b="17,30" style="1" fill="1"/><ELLIPSE a="6,1" b="18,14" style="1" fill="1"/><RECTANGLE a="7,4" b="17,10" style="1" fill="2"/><POLYGON polygon="0" style="2" pos="7.6,5" fill="0"><POINT pos="0,0" arc="0"/><POINT pos="8.8,0" arc="0"/></POLYGON><POLYGON polygon="0" style="2" pos="7.6,6.6" fill="0"><POINT pos="0,0" arc="0"/><POINT pos="8.8,0" arc="0"/></POLYGON><POLYGON polygon="0" style="2" pos="7.6,8.2" fill="0"><POINT pos="0,0" arc="0"/><POINT pos="8.8,0" arc="0"/></POLYGON><POLYGON polygon="0" style="2" pos="7.6,9.799999999999999" fill="0"><POINT pos="0,0" arc="0"/><POINT pos="8.8,0" arc="0"/></POLYGON><RECTANGLE a="8,14" b="16,28" style="1" fill="3"/><ELLIPSE a="10.4,28.4" b="13.6,31.6" style="1" fill="1"/><ELLIPSE a="10.8,28.8" b="13.2,31.2" style="1" fill="2"/><ELLIPSE a="11.22,29.420000000000005" b="11.58,29.78" style="1" fill="4"/><ELLIPSE a="12.42,29.420000000000005" b="12.78,29.78" style="1" fill="4"/><ELLIPSE a="11.82,30.420000000000005" b="12.18,30.78" style="1" fill="4"/><NOTE_TEXT a="9.59140625,26" b="14.40859375,29.139999999999997" font="2" color="453626" style="3" fill="0" direction="3" border_style="2">OUT</NOTE_TEXT><PIN pos="12,30" direction="0" number="1" length="0" number_pos="0" centre_name="0" which="0" elec="4" part="0" show="0">MIC OUT</PIN><NOTE_TEXT a="-0.6,37.8" b="14.8315625,41.5199999
34,86"/><WIRE a="120,66" b="120,70"/><WIRE a="120,70" b="100,70"/><WIRE a="100,70" b="100,134"/><WIRE a="100,134" b="133.5,134"/><WIRE a="133.5,134" b="167,134"/><WIRE a="167,134" b="234,134"/><WIRE a="114,74" b="88,74"/><WIRE a="88,74" b="88,136"/><WIRE a="88,136" b="88,198"/><WIRE a="88,198" b="29,198"/><WIRE a="29,198" b="29,186"/><NOTE_TEXT a="15,10" b="282,21" font="4" color="453626" style="3" fill="0" direction="3" border_style="2">Two-person podcast studio</NOTE_TEXT><NOTE_TEXT a="18,26" b="51.6,31" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">MIC1: Host microphone</NOTE_TEXT><NOTE_TEXT a="18,82" b="53.2,87" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">MIC2: Guest microphone</NOTE_TEXT><NOTE_TEXT a="108,38" b="138.4,43" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">MIX1: Podcast mixer</NOTE_TEXT><NOTE_TEXT a="228,44" b="260,49" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">HP1: Host headphones</NOTE_TEXT><NOTE_TEXT a="230,145" b="282,150" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">HP2: Guest headphones</NOTE_TEXT><NOTE_TEXT a="23,138" b="56.6,143" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">PC1: Recording laptop</NOTE_TEXT><NOTE_TEXT a="120,156" b="278,194" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">MIC1 / MIC2: balanced XLR microphone cables.HP1 / HP2: separate stereo headphone feeds.USB: MIX1 to PC1, carrying recording/playback audio.Use the mixer headphone monitoring to avoid delay.Equipment power and software setup are described in Explanation.</NOTE_TEXT></TinyCAD><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>
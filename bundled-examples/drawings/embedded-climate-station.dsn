ible wiring, not dimensioned PCB footprints. No firmware or SPICE simulation.</DESCRIPTION><PPP>1</PPP><REF_POINT pos="24,29" power="false" part="1"/><TinyCAD><RECTANGLE a="0,0" b="24,23" style="1" fill="1"/><RECTANGLE a="0.375,0.375" b="23.625,22.625" style="2" fill="0"/><ELLIPSE a="1.175,1.175" b="2.325,2.325" style="1" fill="2"/><ELLIPSE a="1.375,1.375" b="2.125,2.125" style="1" fill="3"/><ELLIPSE a="21.675,1.175" b="22.825,2.325" style="1" fill="2"/><ELLIPSE a="21.875,1.375" b="22.625,2.125" style="1" fill="3"/><ELLIPSE a="8.75,6.5" b="15.25,13" style="1" fill="4"/><ELLIPSE a="9.75,7.5" b="14.25,12" style="1" fill="3"/><POLYGON polygon="0" style="5" pos="12,8.5" fill="0"><POINT pos="0,1.25" arc="0"/><POINT pos="1.5,0" arc="0"/></POLYGON><ELLIPSE a="11.75,9.5" b="12.25,10" style="1" fill="8"/><POLYGON polygon="0" style="5" pos="10,9.75" fill="0"><POINT pos="0.5,0" arc="0"/><POINT pos="0,0" arc="0"/></POLYGON><POLYGON polygon="0" style="5" pos="10.58579,8.33579" fill="0"><POINT pos="0.3535499999999999,0.3535499999999999" arc="0"/><POINT pos="0,0" arc="0"/></POLYGON><POLYGON polygon="0" style="5" pos="12,7.75" fill="0"><POINT pos="0,0.5" arc="0"/><POINT pos="0,0" arc="0"/></POLYGON><POLYGON polygon="0" style="5" pos="13.060660000000002,8.33579" fill="0"><POINT pos="0,0.3535499999999999" arc="0"/><POINT pos="0.3535499999999985,0" arc="0"/></POLYGON><POLYGON polygon="0" style="5" pos="13.5,9.75" fill="0"><POINT pos="0,0" arc="0"/><POINT pos="0.5,0" arc="0"/></POLYGON><RECTANGLE a="18.75,5.5" b="19.75,6" style="1" fill="5"/><RECTANGLE a="19,5.5" b="19.5,6" style="1" fill="4"/><RECTANGLE a="18.75,6.75" b="19.75,7.25" style="1" fill="5"/><RECTANGLE a="19,6.75" b="19.5,7.25" style="1" fill="4"/><RECTANGLE a="18.75,8" b="19.75,8.5" style="1" fill="5"/><RECTANGLE a="19,8" b="19.5,8.5" style="1" fill="4"/><RECTANGLE a="3.3,21.3" b="4.699999999999999,22.7" style="1" fill="7"/><ELLIPSE a="3.7700000000000005,21.77" b="4.23,22.23" style="1" fill="6"/><NOTE_TEXT a="2.43,16.49789
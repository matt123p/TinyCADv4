"/><WIRE a="22,62" b="22,72"/><WIRE a="22,72" b="82,72"/><WIRE a="82,72" b="82,64"/><WIRE a="82,64" b="148,64"/><WIRE a="338,64" b="338,82"/><WIRE a="158,92" b="158,102"/><WIRE a="158,102" b="140,102"/><WIRE a="140,102" b="140,112"/><WIRE a="168,92" b="168,104"/><WIRE a="168,104" b="156,104"/><WIRE a="156,104" b="156,112"/><WIRE a="140,112" b="140,118"/><WIRE a="140,118" b="90,118"/><WIRE a="90,118" b="90,198"/><WIRE a="90,198" b="38,198"/><WIRE a="156,112" b="156,120"/><WIRE a="156,120" b="384,120"/><WIRE a="384,120" b="384,170"/><WIRE a="384,170" b="414,170"/><NOTE_TEXT a="8,4" b="478,18" font="5" color="423529" style="2" fill="0" direction="3" border_style="2">Small office network</NOTE_TEXT><NOTE_TEXT a="8,19" b="478,27" font="6" color="423529" style="2" fill="0" direction="3" border_style="2">Editable physical panels with cable connections inside the sockets.</NOTE_TEXT><NOTE_TEXT a="100,36" b="366,46" font="7" color="423529" style="2" fill="0" direction="3" border_style="2">Office rack / four matching 1U panels</NOTE_TEXT><NOTE_TEXT a="8,34" b="50,42" font="6" color="423529" style="2" fill="0" direction="3" border_style="2">ISP terminal / ONT1</NOTE_TEXT><NOTE_TEXT a="58,28" b="95,36" font="6" color="423529" style="2" fill="0" direction="3" border_style="2">ISP fibre</NOTE_TEXT><NOTE_TEXT a="8,140" b="78,150" font="7" color="423529" style="2" fill="0" direction="3" border_style="2">Ceiling access point / AP1</NOTE_TEXT><NOTE_TEXT a="400,140" b="478,150" font="7" color="423529" style="2" fill="0" direction="3" border_style="2">Desk switch / DS1</NOTE_TEXT><NOTE_TEXT a="104,154" b="364,202" font="7" color="423529" style="2" fill="0" direction="3" border_style="2">Cable scheduleONT1 LAN1 -&gt; RTR1 WAN1RTR1 SFP+1 -&gt; SW1 SFP+1SW1 port 4 -&gt; PP1 port 1 -&gt; AP1 PoE/LANSW1 port 6 -&gt; PP1 port 3 -&gt; DS1 port 1</NOTE_TEXT><NOTE_TEXT a="104,204" b="366,232" font="6" color="423529" style="2" fill="0" direction="3" border_style="2">Rack faces touch at 1U intervals. Short patch leads run to PP1; longer runs continue to the office devices.Each socket is one cable endpoint. Spare ports are intentionally left open; this drawing has no SPICE model.</NOTE_TEXT><JUNCTION pos="140,112"/><JUNCTION pos="156,112"/></TinyCAD><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>
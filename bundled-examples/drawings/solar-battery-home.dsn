BOL><WIRE a="88,62" b="117,62"/><WIRE a="193,62" b="220,62"/><WIRE a="220,62" b="220,102"/><WIRE a="220,102" b="222,102"/><WIRE a="88,157" b="117,157"/><WIRE a="193,157" b="220,157"/><WIRE a="220,157" b="220,118"/><WIRE a="220,118" b="222,118"/><WIRE a="298,102" b="327,102"/><WIRE a="403,102" b="405,102"/><WIRE a="405,102" b="405,173"/><WIRE a="405,173" b="220,173"/><WIRE a="220,173" b="220,243"/><WIRE a="220,243" b="222,243"/><WIRE a="88,227" b="117,227"/><WIRE a="193,227" b="222,227"/><WIRE a="298,227" b="327,227"/><NOTE_TEXT a="15,10" b="405,21" font="4" color="453626" style="3" fill="0" direction="3" border_style="2">Home solar and battery plan</NOTE_TEXT><NOTE_TEXT a="18,38" b="56.4,43" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">PV1: Rooftop solar array</NOTE_TEXT><NOTE_TEXT a="123,38" b="159.8,43" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">PVISO1: PV DC isolation</NOTE_TEXT><NOTE_TEXT a="228,78" b="261.6,83" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">INV1: Hybrid inverter</NOTE_TEXT><NOTE_TEXT a="18,133" b="46.8,138" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">BAT1: Wall battery</NOTE_TEXT><NOTE_TEXT a="123,133" b="161.4,138" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">BISO1: Battery isolation</NOTE_TEXT><NOTE_TEXT a="333,78" b="365,83" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">ACISO1: AC isolation</NOTE_TEXT><NOTE_TEXT a="18,203" b="54.8,208" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">GRID1: Electricity grid</NOTE_TEXT><NOTE_TEXT a="123,203" b="143.8,208" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">METER1: Meter</NOTE_TEXT><NOTE_TEXT a="228,203" b="256.8,208" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">CU1: Home fuse box</NOTE_TEXT><NOTE_TEXT a="333,203" b="368.2,208" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">HOME1: Household loads</NOTE_TEXT><NOTE_TEXT a="20,22" b="400,37" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">Energy flows: PV and battery connect to the hybrid inverter; its AC connection joins the home distribution board.The grid/meter branch supplies the same distribution board. Each endpoint represents a whole cable.</NOTE_TEXT><NOTE_TEXT a="20,265" b="400,286" font="5" color="453626" style="3" fill="0" direction="3" border_style="2">Conceptual planning example, not an installation or protection design. Spare backup, EV and battery data ports are open.Battery BMS compatibility, earthing, protection, cable ratings and export controls depend on the actual system. See Explanation.</NOTE_TEXT></TinyCAD><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>
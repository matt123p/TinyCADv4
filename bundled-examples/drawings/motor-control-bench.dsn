LOR></FILL><FILL id="4"><INDEX>0</INDEX><COLOR>E9F1E7</COLOR></FILL><FILL id="5"><INDEX>0</INDEX><COLOR>DAD5CB</COLOR></FILL><FILL id="6"><INDEX>0</INDEX><COLOR>443B30</COLOR></FILL><FILL id="7"><INDEX>0</INDEX><COLOR>91AAED</COLOR></FILL><FILL id="8"><INDEX>0</INDEX><COLOR>DCD4CB</COLOR></FILL><FILL id="9"><INDEX>0</INDEX><COLOR>3D3126</COLOR></FILL><FILL id="10"><INDEX>0</INDEX><COLOR>AF7A48</COLOR></FILL><FILL id="11"><INDEX>0</INDEX><COLOR>9BB569</COLOR></FILL><FILL id="12"><INDEX>0</INDEX><COLOR>FAF7F4</COLOR></FILL><FILL id="13"><INDEX>0</INDEX><COLOR>60B7D8</COLOR></FILL><FILL id="14"><INDEX>0</INDEX><COLOR>8E8ED8</COLOR></FILL><SYMBOLDEF id="1"><NAME type="1">ESP32 DevKitC V4 — WROOM-32E, 38 pins</NAME><GUID>embedded-smart-home/1</GUID><REF type="1">U?</REF><DESCRIPTION>ESP32 DevKitC V4 — WROOM-32E, 38 pins. 3.3 V logic. GPIO34/35/36/39 are input-only. SD0/SD1/SD2/SD3/CMD/CLK are reserved for onboard flash; shown for physical identification, not spare GPIO. WROOM version, not WROVER. Use one supply method. Controller 3V3/5V header rails are typed as power outputs for normal USB/barrel-powered use; VIN is a power input. Alternative power injection through header rails must follow the manufacturer instructions.  Top/component-side wiring views. All contacts of the named wiring headers are explicit. USB, HDMI, Ethernet, ribbon sockets, test pads, solder jumpers and optional debug/auxiliary connectors are outside the wiring interface. Drawings are enlarged and snapped to the normal grid for legible wiring, not dimensioned PCB footprints. No firmware or SPICE simulation.</DESCRIPTION><PPP>1</PPP><REF_POINT pos="30,51" power="false" part="1"/><TinyCAD><RECTANGLE a="0,0" b="30,46" style="1" fill="1"/><RECTANGLE a="0.5,0.5" b="29.5,45.5" style="2" fill="0"/><ELLIPSE a="1.56667,1.56667" b="3.1,3.1" style="1" fill="2"/><ELLIPSE a="1.8333299999999997,1.8333299999999997" b="2.83333,2.83333" style="1" fill="3"/><ELLIPSE a="26.9,1.56667" b="28.43333,3.1" style="1" fill="2
  "experiments": [
    {
      "id": "Q01",
      "title": "Correct meter connections",
      "syllabus_reference": "U3 C1.1–C1.3, U4 C2",
      "catalogue_support": "Both",
      "catalogue_description": "Prepare an ammeter/voltmeter test circuit, then compare readings for a known load. Use V Ω–COM for voltage/resistance and A–COM for current.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [],
      "existing_tool_ids": [
        "multimeter",
        "ammeter",
        "voltmeter",
        "ohmmeter"
      ]
    },
    {
      "id": "Q02",
      "title": "Meter calibration/comparison plan",
      "syllabus_reference": "U4 C2",
      "catalogue_support": "Both",
      "catalogue_description": "Predict readings for several declared reference resistors and source values. Draw the real calibration arrangement and compare bench readings against an independently established reference. A virtual meter is not a calibration certificate for physical equipment.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": [
        "multimeter"
      ]
    },
    {
      "id": "Q03",
      "title": "Series and parallel loads",
      "syllabus_reference": "U3 C1.3, U4 C2",
      "catalogue_support": "Both",
      "catalogue_description": "Build resistor combinations, record individual and supply readings, and compare calculations with modelled and physical measurements.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "resistor",
        "lamp"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q04",
      "title": "Wire resistance versus length",
      "syllabus_reference": "U4 C2",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the test section and meter positions. Enter measured resistances or a stated wire law for each length; plot exported R against length externally.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "resistance_wire"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q05",
      "title": "Resistivity and cross-sectional area",
      "syllabus_reference": "U4 C2",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Annotate measured diameters and lengths for the specified wire comparison. Use measured V/I results to calculate resistivity externally. The solver cannot measure wire diameter or establish a material constant independently.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "resistance_wire",
        "annotation"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q06",
      "title": "Filament-lamp characteristic",
      "syllabus_reference": "U3 C1.4, U4 C2",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the current-limited measurement circuit and compare a real lamp characteristic with an electrothermal or empirical model. Keep a fixed-resistance illustration clearly labelled as an approximation.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "lamp"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q07",
      "title": "Diode polarity and characteristic",
      "syllabus_reference": "U3 C1.4",
      "catalogue_support": "Both",
      "catalogue_description": "Sweep a current-limited source and measure the diode's voltage and current. Compare forward and reverse behaviour using an identified diode model.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "diode"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q08",
      "title": "LED current limiting",
      "syllabus_reference": "U3 C1.4, U4 C2",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Compare current and resistor dissipation for different supply/resistor choices. Use an LED-specific model; light output and damage are not automatic simulation results.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "led"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q09",
      "title": "Thermistor electrical response",
      "syllabus_reference": "U3 C1.4, U4 C2",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Substitute measured R(T) values into the test circuit. Compare current or divider output, recording temperature data independently.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "ntc"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q10",
      "title": "LDR electrical response",
      "syllabus_reference": "U3 C1.4",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Use measured resistance under controlled illumination to predict readings. Changing an arbitrary resistor is a circuit exercise, not a simulated light experiment.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "ldr"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q11",
      "title": "Photodiode readout",
      "syllabus_reference": "U3 C1.4",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Model a reverse-biased detector with calibrated photocurrent and compare output for different loads. Supply the optical response externally.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "photodiode",
        "behavioural_current"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q12",
      "title": "Electrical power and energy",
      "syllabus_reference": "U3 C2–C3",
      "catalogue_support": "Both",
      "catalogue_description": "Compare resistor loads at known voltages. Calculate power and energy for a stated duration from simulated readings, then compare with real measurements where appropriate. Temperature change is not modelled by the resistor alone.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q13",
      "title": "Solar-cell load and output measurements",
      "syllabus_reference": "U4 C3",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the panel, voltmeter and selectable electrical load. Use a declared solar-cell equivalent or measured I–V data to compare output conditions. Irradiance, colour and angle must be measured or explicitly supplied.",
      "source_document": "library-sources/inventory/course-research.txt#btec-applied-science-aaq",
      "experiment_symbol_ids": [
        "solar_cell",
        "rheostat"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "Q14",
      "title": "Solar-cell optical investigation plan",
      "syllabus_reference": "U4 C3",

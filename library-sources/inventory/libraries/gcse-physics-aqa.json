  "experiments": [
    {
      "id": "G01",
      "title": "Resistance of a wire as its length changes",
      "syllabus_reference": "RP3; 4.2.1.3",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the wire, test section, ammeter and voltmeter. Represent each chosen length by a resistance supplied from measurements or a declared wire model. Export V and I, calculate R, and plot R against length externally. Simulation cannot measure wire length or discover its material properties.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistance_wire"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G02",
      "title": "Equivalent resistance of series combinations",
      "syllabus_reference": "RP3; 4.2.1.3",
      "catalogue_support": "Both",
      "catalogue_description": "Compare one, two and three resistors at a fixed supply. Record total current and calculate the equivalent resistance. Use separate saved circuits or a component-value study.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G03",
      "title": "Equivalent resistance of parallel combinations",
      "syllabus_reference": "RP3; 4.2.1.3",
      "catalogue_support": "Both",
      "catalogue_description": "Add branches and compare supply current with the individual branch currents. Show how adding a branch changes the effective load. Keep the numerical demand appropriate to GCSE; AQA does not require the parallel-resistance calculation itself.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G04",
      "title": "I–V investigation: fixed resistor",
      "syllabus_reference": "RP4; 4.2.1.4",
      "catalogue_support": "Both",
      "catalogue_description": "Draw the supply, current-limiting control, ammeter in series and voltmeter across the test resistor. Sweep supply voltage through positive and negative values. Export paired V/I readings for a characteristic graph and a resistance estimate.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G05",
      "title": "I–V investigation: filament lamp",
      "syllabus_reference": "RP4; 4.2.1.4",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the same measurement circuit with a lamp. Compare measured data with an electrothermal or empirical lamp model. A fixed resistor with a lamp symbol will not reproduce the characteristic; a diagram and real laboratory measurements remain useful without that model.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "lamp"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G06",
      "title": "I–V investigation: diode",
      "syllabus_reference": "RP4; 4.2.1.4",
      "catalogue_support": "Both",
      "catalogue_description": "Use a diode model and series limiting resistor. Sweep the supply in both directions and measure voltage across the diode separately from supply voltage. Compare forward conduction and reverse current; use a graph scale that makes the intended feature visible.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "diode"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G07",
      "title": "Choosing and connecting electrical meters",
      "syllabus_reference": "4.2.1.1, 4.2.1.3",
      "catalogue_support": "Both",
      "catalogue_description": "Prepare a resistor test circuit with correctly positioned instruments. Compare a resistance inferred from V/I with a resistance-mode reading on an unpowered circuit. Practise V Ω–COM for voltage/resistance and A–COM for current.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [],
      "existing_tool_ids": [
        "multimeter",
        "ammeter",
        "voltmeter",
        "ohmmeter"
      ]
    },
    {
      "id": "G08",
      "title": "Current at different positions in one loop",
      "syllabus_reference": "4.2.1.2; 4.2.2",
      "catalogue_support": "Both",
      "catalogue_description": "Put current probes before and after different components. Compare readings while changing supply voltage or resistance. Use a short transient capture to connect a steady current with charge transferred over a chosen time.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [],
      "existing_tool_ids": [
        "current_probe",
        "source_pulse"
      ]
    },
    {
      "id": "G09",
      "title": "Voltage sharing in a series circuit",
      "syllabus_reference": "4.2.2",
      "catalogue_support": "Both",
      "catalogue_description": "Choose unequal resistors, measure each voltage and compare their sum with the supply. Swap the resistors and predict the new readings before running.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G10",
      "title": "Branch current and voltage in parallel circuits",
      "syllabus_reference": "4.2.2",
      "catalogue_support": "Both",
      "catalogue_description": "Use two unequal branch resistors. Measure both branch voltages, both currents and the supply current. Repeat with one branch open.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor",
        "switch_spst"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G11",
      "title": "Resistance of an NTC thermistor versus temperature",
      "syllabus_reference": "4.2.1.4",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the measurement circuit and annotate the external temperature measurement. Enter measured R(T) values as separate runs, or supply a calibrated model. Plot resistance against temperature externally. A resistor-value sweep alone is not a temperature experiment.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "ntc"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G12",
      "title": "Resistance of an LDR versus illumination",
      "syllabus_reference": "4.2.1.4",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Draw the LDR test circuit and label the controlled light conditions. Use measured resistance values for electrical predictions. TinyCAD does not model lamp distance, illumination or the LDR's optical response automatically.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "ldr"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G13",
      "title": "Temperature-responsive sensor circuit",
      "syllabus_reference": "4.2.1.4, thermistor applications",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Combine a thermistor-equivalent resistance with a fixed resistor and measure the output as the entered resistance changes. Compare the two sensor positions. This is a possible circuit for exploring the application; potential-divider calculations and a transistor/comparator switching stage are extensions, not additional GCSE requirements.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "ntc",
        "potentiometer"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G14",
      "title": "Light-responsive sensor circuit",
      "syllabus_reference": "4.2.1.4, LDR applications",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Repeat the sensor exercise with light/dark resistance values. Define whether the output should rise or fall as illumination decreases. A complete automatic lamp switch needs an additional switching model; changing resistance alone does not implement a switching threshold.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "ldr",
        "potentiometer"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G15",
      "title": "Resistor power and electrical energy",
      "syllabus_reference": "4.2.4.1–4.2.4.2",
      "catalogue_support": "Both",
      "catalogue_description": "Measure current and voltage for several resistor/supply combinations. Compare calculated power with a power trace; use a transient capture or a timed steady reading to calculate energy. This predicts electrical dissipation, not temperature rise or visible brightness.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "resistor"
      ],
      "existing_tool_ids": []
    },
    {
      "id": "G16",
      "title": "Direct versus alternating voltage",
      "syllabus_reference": "4.2.3.1",
      "catalogue_support": "Both",
      "catalogue_description": "Compare a DC source with a low-voltage sine source on the scope. Identify polarity changes and repeat at different frequencies. This is an electronic demonstration of the distinction; it does not require a mains-voltage experiment.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",
      "experiment_symbol_ids": [
        "bnc"
      ],
      "existing_tool_ids": [
        "source_sine",
        "source_pulse",
        "oscilloscope",
        "function_generator"
      ]
    },
    {
      "id": "G17",
      "title": "LED polarity and a suitable series resistor",
      "syllabus_reference": "4.2.1.1, component symbols; 4.2.1.4, diode behaviour",
      "catalogue_support": "Both, model needed",
      "catalogue_description": "Use an LED-specific model to compare current for different series resistors and supply polarities. This is a syllabus-linked diode application, not a separately required LED practical. Electrical current can be predicted; brightness, colour and damage are not automatically simulated.",
      "source_document": "library-sources/inventory/course-research.txt#gcse-physics-aqa",

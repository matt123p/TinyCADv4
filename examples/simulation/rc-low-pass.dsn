ction="1">0</POWER></TinyCAD><SimulationSheet id="934ae71f-836e-4aaf-8b30-000000000003" name="Frequency response" version="1">{"version":1,"instructions":"Run AC. The ideal source has AC amplitude 1 V; gain OUT/IN has a -3.01 dB corner near 159.15 Hz and phase near -45 degrees. Change R1 or C1 Value to move the corner. Select V1 to change AC amplitude/phase in the source panel. Select PR1 (IN), PR2 (OUT) or VP1 for probe charts; AC amplitude is independent of transient waveform settings.","analysis":{"kind":"ac","duration":"5ms","maxStep":"10us","startFrequency":"10Hz","stopFrequency":"100kHz","pointsPerDecade":100,"source":"","sweepStart":"0","sweepStop":"5","sweepStep":"0.1","input":"","output":"","reference":"0","temperature":"27","initialConditions":false},"signals":["in","out","vp1#branch"],"parameters":{},"models":{},"runs":[],"retainResults":true,"traces":[{"name":"Gain OUT/IN","operation":"divide","left":"out","right":"in"}]}</SimulationSheet><DSNSETTINGS><SHOW_RULERS>1</SHOW_RULERS></DSNSETTINGS><NETLIST_TYPES><TYPE name="default"/></NETLIST_TYPES></TinyCADSheets>

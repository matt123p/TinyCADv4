      "pins": [
        {
          "at": [
            84,
            42
          ],
          "number": "3",
          "name": "Wiper",
          "show": 0
        }
      ],
      "notes": "The source wiper repeated terminal 1; renumbered to 3. Two resistors model the wiper, with a 1 micro-ohm lower bound.",
      "attributes": {
        "Package": {
          "value": "",
          "show": 1
        },
        "Value": {
          "value": "10k",
          "show": 0
        },
        "Wiper": {
          "value": "0.5",
          "show": 1
        },
        "$$SPICE": {
          "value": "R$(refnum)A %(1) %(3) {max(1u,$(Value)*$(Wiper))}\nR$(refnum)B %(3) %(2) {max(1u,$(Value)*(1-$(Wiper)))}",
          "show": 2
        }
      }
    },

    {
      "title": "ngspice manual",
      "url": "https://ngspice.sourceforge.io/docs/ngspice-manual.pdf"
    },
    {
      "title": "TI UA741 data sheet",
      "url": "https://www.ti.com/lit/ds/symlink/ua741.pdf"
    }

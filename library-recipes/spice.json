          "show": 0
        },
        "Motional resistance": {
          "value": "20",
          "show": 1
        },
        "Motional capacitance": {
          "value": "20f",
          "show": 1
        },
        "Shunt capacitance": {
          "value": "3p",
          "show": 1
        },
        "$$SPICE": {
          "value": "X$(ref) %(1) %(2) TC_XTAL PARAMS: FREQ=$(Frequency) RM=$(Motional resistance) CM=$(Motional capacitance) C0=$(Shunt capacitance)",
          "show": 2
        },
        "$$SPICE_PROLOG": {
          "value": ".subckt TC_XTAL A B params: FREQ=8Meg RM=20 CM=20f C0=3p\nRmot A mot1 {RM}\nLmot mot1 mot2 {1/(39.47841760435743*FREQ*FREQ*CM)}\nCmot mot2 B {CM}\nCshunt A B {C0}\n.ends TC_XTAL",
          "show": 2
        },
        "$$SPICE_PROLOG_PRIORITY": {
          "value": "1",
          "show": 2
        }
      },
      "notes": "Quartz variant derived from onetransistor two-terminal ceramic resonator artwork. Generic motional series RLC with a shunt capacitor; nominal series resonance is set by Frequency in Hz. No manufacturer-specific temperature, drive-level, or nonlinear behavior."
    },

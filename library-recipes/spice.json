      ],
      "attributes": {
        "Package": {
          "value": "",
          "show": 1
        },
        "Model": {
          "value": "TC_NPN",
          "show": 1
        },
        "Model File": {
          "value": "",
          "show": 1
        },
        "$$SPICE": {
          "value": "Q$(refnum) %(3) %(1) %(2) $(Model)",
          "show": 2
        },
        "$$SPICE_PROLOG": {
          "value": "?(empty(Model File),.model TC_NPN NPN(Is=1e-14 Bf=200 Vaf=100 Cje=10p Cjc=5p Tf=500p),.include \"$(Model File)\")",
          "show": 2
        }
      },
      "notes": "Generic teaching model; terminals are 3=collector, 1=base, 2=emitter. Pin names retained for connectivity but hidden to keep transistor artwork clear."
